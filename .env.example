# FinAlly environment configuration.
#
# Copy this file to `.env` in the same directory and fill in real values,
# then run scripts/start_mac.sh (macOS/Linux) or scripts/start_windows.ps1
# (Windows). `docker-compose.yml` reads `.env` via `env_file`; the container
# itself never reads a `.env` file directly (see planning/PLAN.md §5, M1).

# Required for the AI chat panel. Without it the app still starts and market
# data / trading / portfolio all work normally — POST /api/chat instead
# returns a structured error that the chat panel renders as a friendly
# "chat unavailable" message. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. If set (non-empty), the backend polls the Massive (Polygon.io)
# REST API for real market data instead of the built-in simulator. Leave
# blank to use the simulator — the intended default for demos and grading.
MASSIVE_API_KEY=

# Optional. Set to "true" to make /api/chat return deterministic, canned
# responses instead of calling OpenRouter. Used by the E2E test suite and for
# local development without an API key. The backend only ever enters mock
# mode via this explicit flag — never as a silent fallback.
LLM_MOCK=false
